# ~/gpu-swap/gpu-profile.conf — normally generated by 02-find-touchpoints.sh. Bash syntax; every value optional.
NVIDIA_MKINITCPIO_MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)   # exact MODULES=() for the nvidia profile
AMD_MKINITCPIO_MODULES=()                                                 # empty = nvidia list minus nvidia* plus amdgpu
CMDLINE_KIND="limine-default"            # limine-default | kernel-cmdline | sd-boot | grub | limine-conf (empty = auto)
CMDLINE_FILE="/etc/default/limine"
NVIDIA_CMDLINE_PARAMS=(nvidia_drm.modeset=1 nvidia-drm.fbdev=1)          # removed for amd, re-inserted for nvidia
NVIDIA_CMDLINE_ANCHOR="root=/dev/mapper/root"                             # token they are re-inserted after
AMD_CMDLINE_PARAMS=()                                                     # nothing AMD-specific is needed
TOGGLE_FILES=(/home/dusty/.config/hypr/envs.conf /home/dusty/.config/hypr/hyprland.conf /etc/modules-load.d/nvidia.conf)
HYPR_ENV_FILE="/home/dusty/.config/hypr/envs.conf"                        # gets the commented AQ_DRM_DEVICES block
DGPU_PCI_ADDR="0000:01:00.0"                                              # top x16 slot (same address before/after the swap)
IGPU_PCI_ADDR="0000:10:00.0"                                              # Raphael iGPU, if enabled in BIOS
LLAMA_UNIT="llama-server.service"        # optional: repoint ExecStart via a drop-in; empty = leave services alone
LLAMA_UNIT_SCOPE="system"                # system | user
LLAMA_EXEC_AMD="/home/dusty/gpu-swap/llama.cpp/build-vulkan/bin/llama-server --host 127.0.0.1 --port 8080 -m /home/dusty/models/Qwen3.8-Flash-Next-AD-4.27bpw-Q4_K_M-M64/Qwen3.8-Flash-Next-AD-4.27bpw-Q4_K_M-M64-00001-of-00033.gguf --mmproj /home/dusty/models/mmproj-Qwen3.8-Flash-Next-F16.gguf -ngl 99 --jinja -fa on -fit on -c 65536"
