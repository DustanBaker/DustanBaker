#!/usr/bin/env bash
# gpu-profile — switch Taichi Station between the NVIDIA (RTX 5090) and AMD
# (2x Radeon AI PRO R9700) GPU profiles. Idempotent; each profile is the
# inverse of the other.
#
#   gpu-profile amd    [--dry-run] [--yes]
#   gpu-profile nvidia [--dry-run] [--yes]
#   gpu-profile status
#
# What a profile changes (every file is backed up first to
# /root/gpu-swap-backup/<timestamp>/<original path>):
#   1. mkinitcpio MODULES=(...)            nvidia set  <->  amdgpu set
#   2. kernel cmdline                      +/- nvidia_drm.modeset=1 nvidia-drm.fbdev=1 (whatever is recorded)
#   3. Hyprland / uwsm / environment files  NVIDIA env lines commented with a marker <-> restored
#   4. Hyprland envs.conf                   AQ_DRM_DEVICES block (commented) added <-> removed
#   5. (optional) llama-server systemd unit drop-in pointing ExecStart at the Vulkan build
#
# --dry-run prints unified diffs and the commands it would run, writes nothing.
# Initramfs regeneration and the bootloader update ask for confirmation
# unless --yes is given.
#
# Testing hooks (used by tests/run.sh and verify-inverse.sh):
#   --root DIR     treat DIR as "/" (no sudo, no mkinitcpio/limine commands)
#   GPU_PROFILE_HOME=/home/x   home directory of the desktop user (default: $SUDO_USER's)
#
# Configuration: $GPU_SWAP_DIR/gpu-profile.conf (generated by 02-find-touchpoints.sh,
# see gpu-profile.conf.example). Every value has an auto-detected default.

set -euo pipefail

PROFILE=""; DRY_RUN=0; YES=0; ROOT_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    amd|nvidia|status) PROFILE="$1" ;;
    --dry-run|-n) DRY_RUN=1 ;;
    --yes|-y) YES=1 ;;
    --root) ROOT_OVERRIDE="${2:?--root needs a directory}"; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$PROFILE" ] || { echo "usage: gpu-profile {amd|nvidia|status} [--dry-run] [--yes] [--root DIR]" >&2; exit 2; }

# ---------------------------------------------------------------- sudo / users
TARGET_USER="${GPU_PROFILE_USER:-${SUDO_USER:-$(id -un)}}"
if [ -z "$ROOT_OVERRIDE" ] && [ "$(id -u)" -ne 0 ]; then
  # /boot is usually root-only, so even --dry-run needs root to read it.
  exec sudo GPU_PROFILE_USER="$TARGET_USER" GPU_PROFILE_HOME="${GPU_PROFILE_HOME:-$HOME}" \
       GPU_SWAP_DIR="${GPU_SWAP_DIR:-$HOME/gpu-swap}" "$0" "$PROFILE" \
       $( [ $DRY_RUN = 1 ] && echo --dry-run ) $( [ $YES = 1 ] && echo --yes )
fi
R="${ROOT_OVERRIDE%/}"                                  # path prefix ("" on the real system)
HOME_DIR="${GPU_PROFILE_HOME:-$(getent passwd "$TARGET_USER" 2>/dev/null | cut -d: -f6)}"
HOME_DIR="${HOME_DIR:-/home/$TARGET_USER}"
GPU_SWAP_DIR="${GPU_SWAP_DIR:-$HOME_DIR/gpu-swap}"
BACKUP_ROOT="${GPU_SWAP_BACKUP_ROOT:-/root/gpu-swap-backup}"
TS="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="$R$BACKUP_ROOT/$TS-$PROFILE"

# ---------------------------------------------------------------- defaults
NVIDIA_MODULE_SET=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
AMD_MODULE_SET=(amdgpu)
NVIDIA_MKINITCPIO_MODULES=()        # exact MODULES=() for the nvidia profile (auto: current line)
AMD_MKINITCPIO_MODULES=()           # exact MODULES=() for the amd profile (auto: nvidia line - nvidia* + amdgpu)
NVIDIA_CMDLINE_PARAMS=()            # tokens to add for nvidia / remove for amd (auto: nvidia* tokens in current cmdline)
NVIDIA_CMDLINE_ANCHOR=""            # token after which the nvidia params are re-inserted (auto: token preceding them)
AMD_CMDLINE_PARAMS=()               # tokens to add for amd / remove for nvidia (default: none)
TOGGLE_FILES=()                     # files whose NVIDIA lines get commented for amd (auto-detected)
HYPR_ENV_FILE=""                    # file that receives the AQ_DRM_DEVICES block (auto: ~/.config/hypr/envs.conf)
DGPU_PCI_ADDR=""                    # e.g. 0000:01:00.0 (auto: lspci)
IGPU_PCI_ADDR=""                    # e.g. 0000:10:00.0 (auto: lspci)
CMDLINE_KIND=""                     # limine-default | kernel-cmdline | sd-boot | grub | limine-conf (auto)
CMDLINE_FILE=""
LLAMA_UNIT=""                       # e.g. llama-server.service (optional)
LLAMA_UNIT_SCOPE="system"           # system | user
LLAMA_EXEC_NVIDIA=""                # not used for writing; the nvidia profile removes the drop-in
LLAMA_EXEC_AMD=""                   # full ExecStart= for the amd profile
NVIDIA_LINE_REGEX='(nvidia|NVD_BACKEND|GBM_BACKEND|__GLX_VENDOR_LIBRARY_NAME|__GL_GSYNC_ALLOWED|__GL_VRR_ALLOWED|__NV_PRIME_RENDER_OFFLOAD|__VK_LAYER_NV_optimus|WLR_NO_HARDWARE_CURSORS|no_hardware_cursors)'
MARKER='# gpu-profile:nvidia-disabled '
BLOCK_BEGIN='# >>> gpu-profile amd (managed; removed by `gpu-profile nvidia`) >>>'
BLOCK_END='# <<< gpu-profile amd <<<'

CONF="$R$GPU_SWAP_DIR/gpu-profile.conf"
[ -f "$CONF" ] || CONF="$GPU_SWAP_DIR/gpu-profile.conf"
STATE="$R$GPU_SWAP_DIR/gpu-profile.state"   # what `gpu-profile amd` removed, so `gpu-profile nvidia` restores it exactly
# shellcheck disable=SC1090
[ -f "$STATE" ] && source "$STATE"
# shellcheck disable=SC1090
[ -f "$CONF" ] && source "$CONF"             # conf wins over recorded state

# ---------------------------------------------------------------- helpers
c_red=$'\e[31m'; c_grn=$'\e[32m'; c_yel=$'\e[33m'; c_bld=$'\e[1m'; c_off=$'\e[0m'
[ -t 1 ] || { c_red=""; c_grn=""; c_yel=""; c_bld=""; c_off=""; }
log()  { printf '%s==>%s %s\n' "$c_bld" "$c_off" "$*"; }
warn() { printf '%s[warn]%s %s\n' "$c_yel" "$c_off" "$*" >&2; }
die()  { printf '%s[error]%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
CHANGED=()        # files whose content will change
CMDS=()           # post-write commands (initramfs, bootloader)

backup_file() {    # backup_file <path under $R>
  local f="$1"
  [ $DRY_RUN = 1 ] && return 0
  mkdir -p "$BACKUP_DIR$(dirname "${f#"$R"}")"
  [ -e "$f" ] && cp -a "$f" "$BACKUP_DIR${f#"$R"}"
  printf '%s\n' "${f#"$R"}" >> "$BACKUP_DIR/MANIFEST"
}

# stage_file <path> <tmpfile-with-new-content> — diff, and (unless dry-run) back up + install.
stage_file() {
  local f="$1" new="$2" existed=1
  [ -e "$f" ] || existed=0
  if [ $existed = 1 ] && cmp -s "$f" "$new"; then
    printf '   %s%s%s unchanged\n' "$c_grn" "${f#"$R"}" "$c_off"; rm -f "$new"; return 0
  fi
  CHANGED+=("${f#"$R"}")
  printf '   %s%s%s will change:\n' "$c_yel" "${f#"$R"}" "$c_off"
  diff -u --label "a${f#"$R"}" --label "b${f#"$R"}" "$([ $existed = 1 ] && echo "$f" || echo /dev/null)" "$new" | sed 's/^/      /' || true
  if [ $DRY_RUN = 0 ]; then
    backup_file "$f"
    if [ $existed = 1 ]; then
      cp "$new" "$f"            # cp into the existing inode keeps owner + mode
    else
      mkdir -p "$(dirname "$f")"
      cp "$new" "$f"
      [ -z "$R" ] && chown --reference="$(dirname "$f")" "$f" 2>/dev/null || true
    fi
  fi
  rm -f "$new"
}

stage_delete() {   # stage_delete <path>
  local f="$1"
  [ -e "$f" ] || { printf '   %s%s%s absent (ok)\n' "$c_grn" "${f#"$R"}" "$c_off"; return 0; }
  CHANGED+=("${f#"$R"}")
  printf '   %s%s%s will be removed:\n' "$c_yel" "${f#"$R"}" "$c_off"
  diff -u --label "a${f#"$R"}" --label /dev/null "$f" /dev/null | sed 's/^/      /' || true
  if [ $DRY_RUN = 0 ]; then backup_file "$f"; rm -f "$f"; fi
}

# token list helpers (space separated strings)
tokens_remove_matching() {  # tokens_remove_matching "<tokens>" <ERE>
  local out=() t; for t in $1; do [[ "$t" =~ $2 ]] || out+=("$t"); done; printf '%s' "${out[*]:-}"
}
tokens_remove_listed() {    # tokens_remove_listed "<tokens>" <t1> <t2> ...
  local toks="$1"; shift; local out=() t x keep
  for t in $toks; do keep=1; for x in "$@"; do [ "$t" = "$x" ] && keep=0; done; [ $keep = 1 ] && out+=("$t"); done
  printf '%s' "${out[*]:-}"
}
tokens_add_missing() {      # tokens_add_missing "<tokens>" <t1> ...
  local toks="$1"; shift; local x
  for x in "$@"; do
    case " $toks " in *" $x "*) ;; *) toks="${toks:+$toks }$x" ;; esac
  done
  printf '%s' "$toks"
}

tokens_insert_after() {    # tokens_insert_after "<tokens>" <anchor> <t1> ... — insert missing tokens right after anchor, else append
  local toks="$1" anchor="$2"; shift 2; local out=() t x missing=()
  for x in "$@"; do case " $toks " in *" $x "*) ;; *) missing+=("$x") ;; esac; done
  [ ${#missing[@]} -eq 0 ] && { printf '%s' "$toks"; return 0; }
  local placed=0
  for t in $toks; do out+=("$t"); if [ $placed = 0 ] && [ -n "$anchor" ] && [ "$t" = "$anchor" ]; then out+=("${missing[@]}"); placed=1; fi; done
  [ $placed = 0 ] && out+=("${missing[@]}")
  printf '%s' "${out[*]}"
}

# ---------------------------------------------------------------- 1. mkinitcpio MODULES
find_mkinitcpio_file() {
  local f last=""
  for f in "$R/etc/mkinitcpio.conf" "$R"/etc/mkinitcpio.conf.d/*.conf; do
    [ -f "$f" ] && grep -Eq '^[[:space:]]*MODULES=' "$f" && last="$f"
  done
  [ -n "$last" ] && printf '%s' "$last" || printf '%s' "$R/etc/mkinitcpio.conf"
}
current_modules() {  # prints the tokens of the last uncommented MODULES=( ... ) line in file
  grep -E '^[[:space:]]*MODULES=' "$1" 2>/dev/null | tail -n1 | sed -E 's/^[[:space:]]*MODULES=\((.*)\).*$/\1/; s/"//g' | xargs 2>/dev/null || true
}
do_mkinitcpio() {
  local f cur want new
  f="$(find_mkinitcpio_file)"
  [ -f "$f" ] || { warn "no mkinitcpio config found at $f — skipping MODULES"; return 0; }
  cur="$(current_modules "$f")"
  if [ ${#NVIDIA_MKINITCPIO_MODULES[@]} -eq 0 ]; then
    # Auto: if the current line already carries nvidia modules it IS the nvidia line, else add the set.
    if [[ " $cur " =~ " nvidia" ]]; then NVIDIA_MKINITCPIO_MODULES=($cur)
    else NVIDIA_MKINITCPIO_MODULES=($(tokens_add_missing "$(tokens_remove_listed "$cur" "${AMD_MODULE_SET[@]}")" "${NVIDIA_MODULE_SET[@]}")); fi
  fi
  if [ ${#AMD_MKINITCPIO_MODULES[@]} -eq 0 ]; then
    AMD_MKINITCPIO_MODULES=($(tokens_add_missing "$(tokens_remove_matching "${NVIDIA_MKINITCPIO_MODULES[*]}" '^nvidia')" "${AMD_MODULE_SET[@]}"))
  fi
  if [ "$PROFILE" = amd ]; then want="${AMD_MKINITCPIO_MODULES[*]}"; else want="${NVIDIA_MKINITCPIO_MODULES[*]}"; fi
  log "mkinitcpio MODULES in ${f#"$R"}: ($cur) -> ($want)"
  new="$(mktemp)"
  awk -v want="$want" '
    /^[[:space:]]*MODULES=/ { n++ }
    { lines[NR]=$0 }
    END {
      k=0
      for (i=1;i<=NR;i++) {
        if (lines[i] ~ /^[[:space:]]*MODULES=/) { k++; if (k==n) { print "MODULES=(" want ")"; continue } }
        print lines[i]
      }
      if (n==0) print "MODULES=(" want ")"
    }' "$f" > "$new"
  stage_file "$f" "$new"
  if [[ " ${CHANGED[*]} " == *" ${f#"$R"} "* ]]; then CMDS+=("mkinitcpio -P"); fi
}

# ---------------------------------------------------------------- 2. kernel cmdline
detect_cmdline() {
  [ -n "$CMDLINE_KIND" ] && return 0
  if [ -f "$R/etc/default/limine" ] && grep -Eq '^[[:space:]]*KERNEL_CMDLINE\[' "$R/etc/default/limine"; then
    CMDLINE_KIND=limine-default; CMDLINE_FILE=/etc/default/limine
  elif [ -f "$R/etc/kernel/cmdline" ]; then
    CMDLINE_KIND=kernel-cmdline; CMDLINE_FILE=/etc/kernel/cmdline
  elif ls "$R"/boot/loader/entries/*.conf >/dev/null 2>&1; then
    CMDLINE_KIND=sd-boot; CMDLINE_FILE="/boot/loader/entries"
  elif [ -f "$R/etc/default/grub" ]; then
    CMDLINE_KIND=grub; CMDLINE_FILE=/etc/default/grub
  else
    local lc
    for lc in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf /boot/EFI/BOOT/limine.conf; do
      [ -f "$R$lc" ] && grep -Eqi '^[[:space:]]*cmdline:' "$R$lc" && { CMDLINE_KIND=limine-conf; CMDLINE_FILE="$lc"; break; }
    done
  fi
  [ -n "$CMDLINE_KIND" ] || { warn "could not find where the kernel cmdline is configured; set CMDLINE_KIND/CMDLINE_FILE in $CONF"; CMDLINE_KIND=none; }
}
CMDLINE_NO_INSERT=0   # set while rewriting a line that must not receive the nvidia tokens (multi-line cmdlines)
transform_cmdline() {  # transform_cmdline "<cmdline string>" -> new string (always whitespace-normalised)
  local toks=($1) s="${toks[*]:-}"
  if [ "$PROFILE" = amd ]; then
    s="$(tokens_remove_matching "$s" '^nvidia[._-]')"
    s="$(tokens_remove_listed "$s" "${NVIDIA_CMDLINE_PARAMS[@]}")"
    [ ${#AMD_CMDLINE_PARAMS[@]} -gt 0 ] && s="$(tokens_add_missing "$s" "${AMD_CMDLINE_PARAMS[@]}")"
  else
    [ ${#AMD_CMDLINE_PARAMS[@]} -gt 0 ] && s="$(tokens_remove_listed "$s" "${AMD_CMDLINE_PARAMS[@]}")"
    [ $CMDLINE_NO_INSERT = 1 ] || s="$(tokens_insert_after "$s" "$NVIDIA_CMDLINE_ANCHOR" "${NVIDIA_CMDLINE_PARAMS[@]}")"
  fi
  printf '%s' "$s"
}
# rewrite_cmdline_lines <file> <awk-regex-of-line-prefix> <mode>
#   mode "quoted": line is  PREFIX"cmdline"   (limine-default, grub)
#   mode "bare":   line is  PREFIX cmdline    (sd-boot `options`, limine `cmdline:`)
#   mode "whole":  the whole file is the cmdline (kernel-cmdline)
rewrite_cmdline_file() {
  local f="$1" prefix_re="$2" mode="$3" new line pre body post out changed=0
  new="$(mktemp)"
  if [ "$mode" = whole ]; then
    body="$(tr '\n' ' ' < "$f" | xargs)"; out="$(transform_cmdline "$body")"
    printf '%s\n' "$out" > "$new"
  else
    # Omarchy splits the cmdline over several KERNEL_CMDLINE[default]+="..." lines. Tokens are removed from
    # every line, but inserted into exactly one: the line holding the anchor token, else the last matching line.
    local n=0 target=0 i=0 q
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue; [[ "$line" =~ $prefix_re ]] || continue
      n=$((n+1)); body="${line#"${BASH_REMATCH[0]}"}"; q=""; [[ "$body" =~ ^[\"\'] ]] && q="${body:0:1}"; body="${body#"$q"}"; body="${body%"$q"}"
      if [ -n "$NVIDIA_CMDLINE_ANCHOR" ] && [[ " $body " == *" $NVIDIA_CMDLINE_ANCHOR "* ]]; then target=$n; fi
    done < "$f"
    [ $target = 0 ] && target=$n
    while IFS= read -r line || [ -n "$line" ]; do
      if [[ "$line" =~ ^[[:space:]]*# ]] || ! [[ "$line" =~ $prefix_re ]]; then printf '%s\n' "$line" >> "$new"; continue; fi
      i=$((i+1)); CMDLINE_NO_INSERT=0; [ $i = $target ] || CMDLINE_NO_INSERT=1
      pre="${BASH_REMATCH[0]}"; body="${line#"$pre"}"
      if [ "$mode" = quoted ]; then
        local q="" lead="" trail=""; [[ "$body" =~ ^[\"\'] ]] && q="${body:0:1}"
        body="${body#"$q"}"; body="${body%"$q"}"; post="$q"
        [ -z "$q" ] && post=""
        # keep the whitespace inside the quotes as it was (Omarchy's += lines start with a space)
        if ! [[ "$body" =~ ^[[:space:]]*$ ]]; then lead="${body%%[![:space:]]*}"; trail="${body##*[![:space:]]}"; fi
        out="$(transform_cmdline "$body")"
        printf '%s%s%s%s%s%s\n' "$pre" "$q" "$lead" "$out" "$trail" "$post" >> "$new"
      else
        out="$(transform_cmdline "$(printf '%s' "$body" | xargs)")"
        printf '%s%s\n' "$pre" "$out" >> "$new"
      fi
    done < "$f"
    CMDLINE_NO_INSERT=0
  fi
  stage_file "$f" "$new"
}
do_cmdline() {
  detect_cmdline
  if [ ${#NVIDIA_CMDLINE_PARAMS[@]} -eq 0 ]; then
    # Auto: whatever nvidia* tokens exist today (config file first, then the running kernel)
    local src=""
    case "$CMDLINE_KIND" in
      limine-default) src="$(grep -E '^[[:space:]]*KERNEL_CMDLINE\[' "$R$CMDLINE_FILE" | sed -E 's/^[^=]*=//; s/^["'"'"']//; s/["'"'"']$//' | tr '\n' ' ')" ;;
      kernel-cmdline) src="$(cat "$R$CMDLINE_FILE")" ;;
      grub)           src="$(grep -E '^[[:space:]]*GRUB_CMDLINE_LINUX(_DEFAULT)?=' "$R$CMDLINE_FILE" | sed -E 's/^[^=]*=//; s/^"//; s/"$//' | tr '\n' ' ')" ;;
      sd-boot)        src="$(grep -hE '^[[:space:]]*options[[:space:]]' "$R"/boot/loader/entries/*.conf | sed -E 's/^[[:space:]]*options[[:space:]]+//' | tr '\n' ' ')" ;;
      limine-conf)    src="$(grep -hEi '^[[:space:]]*cmdline:' "$R$CMDLINE_FILE" | sed -E 's/^[[:space:]]*cmdline:[[:space:]]*//I' | tr '\n' ' ')" ;;
    esac
    [ -z "$src" ] && [ -z "$R" ] && [ -r /proc/cmdline ] && src="$(cat /proc/cmdline)"
    local t prev=""; for t in $src; do
      if [[ "$t" =~ ^nvidia[._-] ]]; then [ ${#NVIDIA_CMDLINE_PARAMS[@]} -eq 0 ] && [ -z "$NVIDIA_CMDLINE_ANCHOR" ] && NVIDIA_CMDLINE_ANCHOR="$prev"; NVIDIA_CMDLINE_PARAMS+=("$t"); fi
      prev="$t"
    done
    # de-duplicate
    [ ${#NVIDIA_CMDLINE_PARAMS[@]} -gt 0 ] && mapfile -t NVIDIA_CMDLINE_PARAMS < <(printf '%s\n' "${NVIDIA_CMDLINE_PARAMS[@]}" | awk '!seen[$0]++')
    [ ${#NVIDIA_CMDLINE_PARAMS[@]} -eq 0 ] && NVIDIA_CMDLINE_PARAMS=(nvidia_drm.modeset=1 nvidia-drm.fbdev=1)
  fi
  log "kernel cmdline via $CMDLINE_KIND ($CMDLINE_FILE): nvidia tokens = ${NVIDIA_CMDLINE_PARAMS[*]}; amd tokens = ${AMD_CMDLINE_PARAMS[*]:-(none)}"
  local before=${#CHANGED[@]}
  case "$CMDLINE_KIND" in
    limine-default) rewrite_cmdline_file "$R$CMDLINE_FILE" '^[[:space:]]*KERNEL_CMDLINE\[[^]]*\]\+?=' quoted
                    [ ${#CHANGED[@]} -gt $before ] && CMDS+=("limine-update") || true ;;
    kernel-cmdline) rewrite_cmdline_file "$R$CMDLINE_FILE" '' whole
                    [ ${#CHANGED[@]} -gt $before ] && CMDS+=("mkinitcpio -P") || true ;;
    sd-boot)        local e; for e in "$R"/boot/loader/entries/*.conf; do rewrite_cmdline_file "$e" '^[[:space:]]*options[[:space:]]+' bare; done ;;
    grub)           rewrite_cmdline_file "$R$CMDLINE_FILE" '^[[:space:]]*GRUB_CMDLINE_LINUX(_DEFAULT)?=' quoted
                    [ ${#CHANGED[@]} -gt $before ] && CMDS+=("grub-mkconfig -o /boot/grub/grub.cfg") || true ;;
    limine-conf)    warn "editing $CMDLINE_FILE directly; limine-update/limine-mkinitcpio may regenerate it from /etc/default/limine"
                    rewrite_cmdline_file "$R$CMDLINE_FILE" '^[[:space:]]*[cC][mM][dD][lL][iI][nN][eE]:[[:space:]]*' bare ;;
    none) ;;
  esac
}

# ---------------------------------------------------------------- 3. env / toggle files
detect_toggle_files() {
  [ ${#TOGGLE_FILES[@]} -gt 0 ] && return 0
  local cands=( "$HOME_DIR/.config/hypr/envs.conf" "$HOME_DIR/.config/hypr/hyprland.conf"
                "$HOME_DIR/.config/uwsm/env" "$HOME_DIR/.config/uwsm/env-hyprland"
                /etc/environment /etc/modules-load.d/*.conf "$HOME_DIR"/.config/environment.d/*.conf
                "$HOME_DIR"/.config/hypr/*.conf )
  local f; for f in "${cands[@]}"; do
    f="${f#"$R"}"; [ -f "$R$f" ] || continue
    if grep -Eq "^[[:space:]]*[^#].*${NVIDIA_LINE_REGEX}" "$R$f" || grep -Fq "$MARKER" "$R$f" || grep -Fq "$BLOCK_BEGIN" "$R$f"; then
      case " ${TOGGLE_FILES[*]:-} " in *" $f "*) ;; *) TOGGLE_FILES+=("$f") ;; esac
    fi
  done
  [ -z "$HYPR_ENV_FILE" ] && HYPR_ENV_FILE="$HOME_DIR/.config/hypr/envs.conf"
}
is_setting_line() {  # not blank, not a comment
  [[ "$1" =~ ^[[:space:]]*$ ]] && return 1
  [[ "$1" =~ ^[[:space:]]*# ]] && return 1
  return 0
}
toggle_file() {  # comment/uncomment NVIDIA lines; manage AQ_DRM_DEVICES block if this is HYPR_ENV_FILE
  local f="$1" new line in_block=0 held_blank=0
  new="$(mktemp)"
  while IFS= read -r line || [ -n "$line" ]; do
    # existing managed block: drop it entirely (re-added below for amd)
    if [ "$line" = "$BLOCK_BEGIN" ]; then in_block=1; held_blank=0; continue; fi
    if [ $in_block = 1 ]; then [ "$line" = "$BLOCK_END" ] && in_block=0; continue; fi
    if [ -z "$line" ]; then held_blank=$((held_blank+1)); continue; fi   # hold blank lines; the spacer before our block must be removable
    while [ $held_blank -gt 0 ]; do printf '\n' >> "$new"; held_blank=$((held_blank-1)); done
    if [ "$PROFILE" = amd ]; then
      if is_setting_line "$line" && [[ "$line" =~ $NVIDIA_LINE_REGEX ]]; then
        printf '%s%s\n' "$MARKER" "$line" >> "$new"; continue
      fi
    else
      if [[ "$line" == "$MARKER"* ]]; then printf '%s\n' "${line#"$MARKER"}" >> "$new"; continue; fi
    fi
    printf '%s\n' "$line" >> "$new"
  done < "$f"
  # trailing blank lines are real content, except the one spacer we add in front of our block
  if grep -Fq "$BLOCK_BEGIN" "$f" && [ $held_blank -gt 0 ]; then held_blank=$((held_blank-1)); fi
  while [ $held_blank -gt 0 ]; do printf '\n' >> "$new"; held_blank=$((held_blank-1)); done
  if [ "$PROFILE" = amd ] && [ "${f#"$R"}" = "$HYPR_ENV_FILE" ]; then
    [ -s "$new" ] && [ -n "$(tail -c1 "$new")" ] && printf '\n' >> "$new"
    { printf '\n%s\n' "$BLOCK_BEGIN"; amd_block_body; printf '%s\n' "$BLOCK_END"; } >> "$new"
  fi
  stage_file "$f" "$new"
}
detect_pci() {
  [ -n "$DGPU_PCI_ADDR" ] && [ -n "$IGPU_PCI_ADDR" ] && return 0
  command -v lspci >/dev/null 2>&1 || return 0
  [ -n "$R" ] && return 0
  local line addr vendor dev
  while read -r line; do
    addr="${line%% *}"; vendor="$(printf '%s' "$line" | grep -oE '\[?[0-9a-f]{4}:[0-9a-f]{4}\]?' | tail -n1 | tr -d '[]')"
    case "$vendor" in
      10de:*) [ -z "$DGPU_PCI_ADDR" ] && DGPU_PCI_ADDR="$addr" ;;
      1002:164e|1002:13c0|1002:1900|1002:15bf|1002:15c8|1002:1586|1002:150e|1002:1114) [ -z "$IGPU_PCI_ADDR" ] && IGPU_PCI_ADDR="$addr" ;;
      1002:*) [ -z "$DGPU_PCI_ADDR" ] && DGPU_PCI_ADDR="$addr" ;;
    esac
  done < <(lspci -Dnn -d ::0300 2>/dev/null; lspci -Dnn -d ::0302 2>/dev/null)
}
amd_block_body() {
  detect_pci
  local d="${DGPU_PCI_ADDR:-0000:01:00.0}" i="${IGPU_PCI_ADDR:-<iGPU address: lspci -Dnn -d ::0300>}"
  cat <<BLK
# Hyprland uses aquamarine, so the variable is AQ_DRM_DEVICES (WLR_DRM_DEVICES is the old wlroots name).
# The discrete card in the top x16 slot inherits the PCI address the RTX 5090 has today: $d
# Ryzen 7800X3D iGPU (Raphael, 1002:164e): ${i}
# If Hyprland comes up on the iGPU (laggy, HDMI on the motherboard works but the card outputs do not),
# uncomment ONE of the lines below and restart Hyprland. Check names with: ls -l /dev/dri/by-path/
# Put the card you want as the primary (the one with the monitor) first; multiple devices are colon separated.
#env = AQ_DRM_DEVICES,/dev/dri/by-path/pci-${d}-card
#env = AQ_DRM_DEVICES,/dev/dri/by-path/pci-${d}-card:/dev/dri/by-path/pci-<second-card>-card
BLK
}
do_toggle_files() {
  detect_toggle_files
  if [ "$PROFILE" = amd ] && [ ! -f "$R$HYPR_ENV_FILE" ]; then
    warn "$HYPR_ENV_FILE does not exist; creating it for the AQ_DRM_DEVICES block"
    mkdir -p "$(dirname "$R$HYPR_ENV_FILE")"; : > "$R$HYPR_ENV_FILE"
    case " ${TOGGLE_FILES[*]:-} " in *" $HYPR_ENV_FILE "*) ;; *) TOGGLE_FILES+=("$HYPR_ENV_FILE") ;; esac
  fi
  if [ "$PROFILE" = amd ]; then case " ${TOGGLE_FILES[*]:-} " in *" $HYPR_ENV_FILE "*) ;; *) TOGGLE_FILES+=("$HYPR_ENV_FILE") ;; esac; fi
  log "env / module-load files: ${TOGGLE_FILES[*]:-(none found)}"
  local f; for f in "${TOGGLE_FILES[@]}"; do toggle_file "$R$f"; done
}

# ---------------------------------------------------------------- 4. llama-server unit drop-in (optional)
do_llama_unit() {
  [ -n "$LLAMA_UNIT" ] || return 0
  local dir
  if [ "$LLAMA_UNIT_SCOPE" = user ]; then dir="$R$HOME_DIR/.config/systemd/user/$LLAMA_UNIT.d"; else dir="$R/etc/systemd/system/$LLAMA_UNIT.d"; fi
  local dropin="$dir/gpu-profile.conf"
  log "llama-server unit $LLAMA_UNIT ($LLAMA_UNIT_SCOPE): drop-in $dropin"
  if [ "$PROFILE" = amd ]; then
    [ -n "$LLAMA_EXEC_AMD" ] || { warn "LLAMA_EXEC_AMD not set; skipping unit drop-in"; return 0; }
    local new; new="$(mktemp)"
    printf '# Written by gpu-profile amd. Removed by gpu-profile nvidia.\n[Service]\nExecStart=\nExecStart=%s\n' "$LLAMA_EXEC_AMD" > "$new"
    [ $DRY_RUN = 0 ] && mkdir -p "$dir"
    stage_file "$dropin" "$new"
  else
    stage_delete "$dropin"
    [ $DRY_RUN = 0 ] && [ -d "$dir" ] && rmdir "$dir" 2>/dev/null || true
  fi
  if [[ " ${CHANGED[*]:-} " == *" ${dropin#"$R"} "* ]]; then
    if [ "$LLAMA_UNIT_SCOPE" = user ]; then CMDS+=("sudo -u $TARGET_USER XDG_RUNTIME_DIR=/run/user/$(id -u "$TARGET_USER" 2>/dev/null || echo 1000) systemctl --user daemon-reload");
    else CMDS+=("systemctl daemon-reload"); fi
  fi
}

# ---------------------------------------------------------------- status
do_status() {
  detect_cmdline; detect_toggle_files; detect_pci
  local f; f="$(find_mkinitcpio_file)"
  echo "mkinitcpio file : ${f#"$R"}  MODULES=($(current_modules "$f"))"
  echo "cmdline source  : $CMDLINE_KIND $CMDLINE_FILE"
  [ -z "$R" ] && [ -r /proc/cmdline ] && echo "running cmdline : $(cat /proc/cmdline)"
  echo "toggle files    : ${TOGGLE_FILES[*]:-(none)}"
  local n_marked=0 n_active=0
  for f in "${TOGGLE_FILES[@]:-}"; do [ -f "$R$f" ] || continue
    n_marked=$((n_marked + $(grep -Fc "$MARKER" "$R$f" || true)))
    n_active=$((n_active + $(grep -Ec "^[[:space:]]*[^#].*${NVIDIA_LINE_REGEX}" "$R$f" || true)))
  done
  echo "nvidia env lines: $n_active active, $n_marked disabled by gpu-profile"
  echo "dGPU / iGPU PCI : ${DGPU_PCI_ADDR:-?} / ${IGPU_PCI_ADDR:-?}"
  local cur; cur="$(current_modules "$f")"
  if [[ " $cur " == *" nvidia"* ]]; then echo "active profile  : nvidia"; elif [[ " $cur " == *" amdgpu "* ]]; then echo "active profile  : amd"; else echo "active profile  : unknown"; fi
}

# ---------------------------------------------------------------- main
if [ "$PROFILE" = status ]; then do_status; exit 0; fi
log "gpu-profile $PROFILE  $([ $DRY_RUN = 1 ] && echo '(DRY RUN — nothing will be written)' || echo "(backups -> ${BACKUP_DIR#"$R"})")"
[ -n "$R" ] && log "root override: $R (no sudo, no initramfs/bootloader commands)"
do_mkinitcpio
do_cmdline
do_toggle_files
do_llama_unit

echo
if [ ${#CHANGED[@]} -eq 0 ]; then
  log "${c_grn}no file changes needed — profile '$PROFILE' is already applied${c_off}"
else
  log "files ${DRY_RUN:+that would be }changed: ${CHANGED[*]}"
fi
# de-duplicate commands, mkinitcpio before the bootloader update
if [ ${#CMDS[@]} -gt 0 ]; then
  mapfile -t CMDS < <(printf '%s\n' "${CMDS[@]}" | awk '!seen[$0]++' | sort -r)
  if [[ " ${CMDS[*]} " == *" limine-update "* ]] && ! command -v limine-update >/dev/null 2>&1 && [ -z "$R" ]; then
    if command -v limine-mkinitcpio >/dev/null 2>&1; then CMDS=("${CMDS[@]/limine-update/limine-mkinitcpio}"); else warn "neither limine-update nor limine-mkinitcpio found; regenerate the Limine config by hand"; fi
  fi
  log "post-write commands: $(printf '%s; ' "${CMDS[@]}")"
  if [ $DRY_RUN = 0 ] && [ -z "$R" ]; then
    if [ $YES = 0 ]; then
      [ -t 0 ] || die "refusing to touch the initramfs/bootloader without a terminal; re-run with --yes"
      read -r -p "Run these now (regenerates initramfs / bootloader config)? [y/N] " ans
      [[ "$ans" =~ ^[Yy] ]] || { warn "skipped. Run them yourself before rebooting: ${CMDS[*]}"; exit 0; }
    fi
    for c in "${CMDS[@]}"; do log "running: $c"; bash -c "$c"; done
  fi
fi
[ $DRY_RUN = 0 ] && [ -z "$R" ] && [ ${#CHANGED[@]} -gt 0 ] && printf '%s\n' "profile=$PROFILE" "date=$TS" "cmds=${CMDS[*]:-}" >> "$BACKUP_DIR/MANIFEST"
if [ $DRY_RUN = 0 ] && [ "$PROFILE" = amd ]; then
  mkdir -p "$(dirname "$STATE")"
  {
    echo "# written by gpu-profile amd on $TS — what was removed, so 'gpu-profile nvidia' can put it back exactly"
    echo "NVIDIA_MKINITCPIO_MODULES=(${NVIDIA_MKINITCPIO_MODULES[*]})"
    echo "NVIDIA_CMDLINE_PARAMS=(${NVIDIA_CMDLINE_PARAMS[*]})"
    echo "NVIDIA_CMDLINE_ANCHOR=\"$NVIDIA_CMDLINE_ANCHOR\""
    echo "TOGGLE_FILES=(${TOGGLE_FILES[*]})"
    echo "HYPR_ENV_FILE=\"$HYPR_ENV_FILE\""
    echo "CMDLINE_KIND=\"$CMDLINE_KIND\""
    echo "CMDLINE_FILE=\"$CMDLINE_FILE\""
  } > "$STATE"
  [ -z "$R" ] && chown "$TARGET_USER" "$STATE" 2>/dev/null || true
fi
exit 0
